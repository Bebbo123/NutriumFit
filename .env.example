# NutriumFit - Production Environment Variables Example
# Duplicate this file to .env and configure the actual values.

# Supabase Configurations
# URL of your Supabase project (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous client key for your Supabase project (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
